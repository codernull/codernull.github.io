    {"id":"p1-text","type":"text","x":50,"y":430,"width":360,"height":65,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["g-etcd"],"frameId":null,"roundness":null,"seed":1060,"version":1,"versionNonce":1060,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false,"text":"条目标识: (index, term)\n一致性检查: prevLogIndex+prevLogTerm 强前缀匹配\n冲突处理: leader 按 Match/Next 回退，覆盖冲突尾部\nLeader 侧状态: progress tracker 精确跟踪每个 follower","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":65,"containerId":null,"originalText":"条目标识: (index, term)\n一致性检查: prevLogIndex+prevLogTerm 强前缀匹配\n冲突处理: leader 按 Match/Next 回退，覆盖冲突尾部\nLeader 侧状态: progress tracker 精确跟踪每个 follower","lineHeight":1.25},

    {"id":"p2-text","type":"text","x":490,"y":430,"width":360,"height":65,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["g-mongo"],"frameId":null,"roundness":null,"seed":1061,"version":1,"versionNonce":1061,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false,"text":"条目标识: (Timestamp, term)，无全局 Raft index\n一致性检查: 批次内 OpTime 单调，非强前缀匹配\n冲突处理: 走 rollback 重新拉取，非精确截断\nPrimary 侧状态: 依赖心跳间接推算多数派进度","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":65,"containerId":null,"originalText":"条目标识: (Timestamp, term)，无全局 Raft index\n一致性检查: 批次内 OpTime 单调，非强前缀匹配\n冲突处理: 走 rollback 重新拉取，非精确截断\nPrimary 侧状态: 依赖心跳间接推算多数派进度","lineHeight":1.25},

    {"id":"p3-text","type":"text","x":930,"y":430,"width":360,"height":65,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["g-redis"],"frameId":null,"roundness":null,"seed":1062,"version":1,"versionNonce":1062,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false,"text":"条目标识: 只有 offset，无 term\n一致性检查: 无日志共识，无前缀匹配\n冲突处理: 断线过久 → 全量重同步(FULLRESYNC)\n提交语义: 无集群级 commit index 概念","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":65,"containerId":null,"originalText":"条目标识: 只有 offset，无 term\n一致性检查: 无日志共识，无前缀匹配\n冲突处理: 断线过久 → 全量重同步(FULLRESYNC)\n提交语义: 无集群级 commit index 概念","lineHeight":1.25},

    {"id":"summary-rect","type":"rectangle","x":30,"y":655,"width":1280,"height":75,"angle":0,"strokeColor":"#495057","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1070,"version":1,"versionNonce":1070,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false},
    {"id":"summary-text","type":"text","x":50,"y":668,"width":1240,"height":57,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1071,"version":1,"versionNonce":1071,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false,"text":"小结：etcd「推 + 前缀检查」→ 提交安全性强，可精确推导多数派提交点；\nMongoDB「拉 + 心跳推算」→ 更灵活，但提交点推导路径更长，冲突靠 rollback；\nRedis「流式复制」→ 无共识日志层面的冲突解决，也没有 commit index 概念。","fontSize":15,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":57,"containerId":null,"originalText":"小结：etcd「推 + 前缀检查」→ 提交安全性强，可精确推导多数派提交点；\nMongoDB「拉 + 心跳推算」→ 更灵活，但提交点推导路径更长，冲突靠 rollback；\nRedis「流式复制」→ 无共识日志层面的冲突解决，也没有 commit index 概念。","lineHeight":1.25}
